# 이 파일을 복사해 .env.local 을 만들고, = 뒤에 AI Studio에서 받은 키를 붙여 넣으세요.
# .env.local 은 .gitignore 로 저장소에 올라가지 않습니다. 이 .env.example 에는 진짜 키를 쓰지 마세요.
GEMINI_API_KEY=

# (선택) 사용할 모델. 비워 두면 gemini-3.5-flash-lite
# 지원 예시: gemini-3.5-flash-lite, gemini-3.8-flash
GEMINI_MODEL=

# (선택) 추론 강도. 비워 두면 low (gemini-3.5-flash-lite / gemini-3.8-flash 공통 호환)
# 지원 예시: low, medium, high (minimal은 gemini-3.5-flash-lite 전용)
GEMINI_THINKING_LEVEL=

# ---- 5차시: Supabase 저장 (서버 함수에서만 읽음, 진짜 값은 .env.local 또는 배포 환경변수에만) ----
# Supabase 프로젝트 주소 (Project Settings → API)
SUPABASE_URL=
# 모든 권한 키(secret key). 브라우저·저장소·대화창에 붙여넣지 않기
SUPABASE_SECRET_KEY=
# 교사 조회 코드. 교사가 정함
TEACHER_CODE=
